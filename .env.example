# Backend listener
BACKEND_HOST=127.0.0.1
BACKEND_PORT=9000
BACKEND_LOG_LEVEL=info

# Local database and analysis retention
DATABASE_URL=sqlite:///./data/assisted_trading.db
ANALYSIS_RETENTION_DAYS=30
MACRO_VALIDITY_MINUTES=15
MARKET_SNAPSHOT_MAX_AGE_SECONDS=30

# OpenRouter: each agent can use a different model ID from your OpenRouter account
OPENROUTER_MODEL_NEWS_ANALYSIS=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODEL_TECHNICAL_INTERPRETATION=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MODEL_DECISION=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_API_KEY=
OPENROUTER_TIMEOUT_SECONDS=60

# Optional comma-separated list of up to five HTTPS RSS/Atom feeds
NEWS_RSS_URLS=
